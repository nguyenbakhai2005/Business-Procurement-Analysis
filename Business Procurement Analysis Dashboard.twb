      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1wzss711bl5j0j1c9qcba1gwusrb].[ctd:PO Number:qk]&quot;' value='Total Orders' />
          <alias key='&quot;[federated.1wzss711bl5j0j1c9qcba1gwusrb].[sum:Line Net:qk]&quot;' value='Total Cost' />
          <alias key='&quot;[federated.1wzss711bl5j0j1c9qcba1gwusrb].[usr:Calculation_0661422542860288:qk]&quot;' value='On Time Delivery Rate' />
        </aliases>
      </column>
      <column caption='Maverick Total Spend' datatype='real' name='[Calculation_0333768419696641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Maverick Spend] = &apos;Yes&apos; then [Line Net] else 0 end)' />
      </column>
      <column caption='Total Maverick Orders' datatype='integer' name='[Calculation_0333768422121474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Maverick Spend] = &apos;Yes&apos; then 1 else 0 end)' />
      </column>
      <column caption='Maverick Spend Percent' datatype='real' name='[Calculation_0333768423534595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Maverick Spend] = &apos;Yes&apos; then [Line Net] else 0 end) / sum([Line Net])' />
      </column>
      <column caption='Savings Percent' datatype='real' name='[Calculation_0333768500531208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Budget Total]) - sum([Line Net])) / sum([Budget Total])' />
      </column>
      <column caption='Avg Spend per Order' datatype='real' name='[Calculation_0333768550060041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Line Net]) / count([PO Number])' />
      </column>
      <column caption='Avg Savings per Order' datatype='real' name='[Calculation_0333768551317514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Savings Amount]) / count([PO Number])' />
      </column>
      <column caption='On Time Percent' datatype='real' name='[Calculation_0661422542860288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [On Time Delivery] = &apos;Yes&apos; then 1 else 0 end) / count([PO Number])' />
