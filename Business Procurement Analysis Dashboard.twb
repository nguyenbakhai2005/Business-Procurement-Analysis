      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Supplier Risk:nk]' type='palette'>
            <map to='#7c4d79'>
              <bucket>&quot;High&quot;</bucket>
            </map>
            <map to='#b27ba1'>
              <bucket>&quot;Medium&quot;</bucket>
            </map>
            <map to='#e0b2d2'>
              <bucket>&quot;Low&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Invoice Match Type:nk]' type='palette'>
            <map to='#7c4d79'>
              <bucket>&quot;No Match&quot;</bucket>
            </map>
            <map to='#b27ba1'>
              <bucket>&quot;3-Way Match&quot;</bucket>
            </map>
            <map to='#e0b2d2'>
              <bucket>&quot;2-Way Match&quot;</bucket>
            </map>
          </encoding>
